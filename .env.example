NODE_ENV=development
PORT=4000

# Origin web yang diizinkan (CORS REST + handshake Socket.IO).
# Pisahkan dengan koma untuk beberapa origin, contoh akses dari HP:
#   WEB_ORIGIN=http://localhost:3000,http://192.168.0.104:3000
WEB_ORIGIN=http://localhost:3000

# Izinkan origin jaringan privat (localhost, 10.x, 192.168.x, 172.16-31.x).
# Default: true saat NODE_ENV bukan production. Set "false" untuk mengunci.
# Secure flag for the session cookie. Follows NODE_ENV unless set explicitly.
# Production refuses to start with COOKIE_SECURE=false, because that would let
# any network attacker read the session token.
# COOKIE_SECURE=true

ALLOW_PRIVATE_ORIGIN=true

# Host + port API realtime. Browser memakai hostname halaman yang sedang dibuka,
# jadi port saja yang perlu diubah kalau port API tidak 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgresql://chating:chating@localhost:5432/chating?schema=public
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=chating_session
SESSION_TTL_SECONDS=604800
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.test
EMAIL_API_KEY=
